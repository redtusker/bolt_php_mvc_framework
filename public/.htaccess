# Disable Directory Browsing
    ## Prevents users from seeing a directory listing if no index file (like index.php or index.html) exists. 
    ## Improves security by hiding the contents of directories.
Options -Indexes

<IfModule mod_rewrite.c>
    <IfModule mod_negotiation.c>
        Options -MultiViews -Indexes
    </IfModule>

    # Ensures symbolic links are followed (necessary for URL rewriting).
    Options +FollowSymlinks
    
    # Turns on the URL rewrite engine to apply the rules defined below.
    RewriteEngine On

    # Handle Authorization Header
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    # Redirect Trailing Slashes If Not A Folder...
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_URI} (.+)/$
    RewriteRule ^ %1 [L,R=301]

    # Force Non-WWW URL -> Rewrite "www.example.com -> example.com"
	RewriteCond %{HTTPS} !=on
	RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
	RewriteRule ^ http://%1%{REQUEST_URI} [R=301,L]

    # Send Requests To Front Controller...
    # Checks to see if the user is attempting to access a valid file,
	# such as an image or css document, if this isn't true it sends the
	# request to the front controller, index.php
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^([\s\S]*)$ index.php/$1 [L,NC,QSA]

    ## Redirects all other requests to index.php with the requested URI appended.
    ## NC: Case-insensitive matching.
    ## QSA: Appends query string arguments to the redirected URL.
</IfModule>

<IfModule !mod_rewrite.c>
	# If we don't have mod_rewrite installed, all 404's
	# can be sent to index.php, and everything works as normal.
	ErrorDocument 404 index.php
</IfModule>

# Restrict Access to Sensitive Files
<FilesMatch "(\.env|\.htaccess|composer\.(json|lock)|.*\.config|.*\.ini|.*\.bak|.*\.sql|.*\.log)">
    Require all denied
</FilesMatch>

# Disable server signature start
ServerSignature Off
# Disable server signature end

## Hides the Apache version and module information from error pages and directory listings.
## Improves security by limiting exposure of server details.


